# copy to .dev.vars for `wrangler dev` — same names as `wrangler secret put`
GE_READ_TOKEN=read-test-token
GE_WRITE_TOKEN=write-test-token
GE_URL_SIGNING_KEY=dev-only-signing-key-32-bytes-minimum-ok

# optional push events webhook (both or neither) — see SETUP.md
# GE_PUSH_WEBHOOK_URL=http://127.0.0.1:8899/hook
# GE_PUSH_WEBHOOK_SECRET=dev-only-push-webhook-secret-32-bytes-min

# optional tuning (defaults in parens) — see SETUP.md
# GE_QUOTA_MAX_OBJECTS=2000000
# GE_QUOTA_MAX_BYTES=4294967296
# GE_QUOTA_MAX_REPOS_PER_OWNER=50
# GE_RATE_PUSHES_PER_MIN=30
# live+ingesting pack admission cap — over it, push/import begin refuse 503 + Retry-After
# GE_MAX_LIVE_PACKS=1000
# GC tuning (defaults in parens) — see SETUP.md
# GE_GC_QUIET_MS=600000      # quiet period before GC consolidates after a push
# GE_GC_GRACE_MS=3600000     # grace before dead packs are swept
# GE_GC_BARRIER=0            # 1 = barrier-mode mark (opt-in, per GC chain)
# GE_COMPACT_FANIN=16        # min same-tier live packs that trigger a compact (min 2)
# GE_COMPACT_MIN_AGE_MS=60000
# GE_COMPACT_MAX_ROWS=100000
